# Cloud sessions (Linux) and your PC (Windows) both write to this repo: keep LF everywhere.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Godot / data files are text
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# binaries
*.png binary
*.jpg binary
*.pdf binary
*.ogg binary
*.wav binary
*.glb binary
*.exe binary
*.ttf binary
*.otf binary

# Large originals live in art_source/ (outside the exported asset tree) and go through Git LFS.
# Requires `git lfs install` once per machine. Cloud sessions do not need these files.
art_source/** filter=lfs diff=lfs merge=lfs -text
# Godot-ignore marker and placeholder in art_source/ stay plain text so a clone without LFS still has them.
art_source/.gdignore -filter -diff -merge text
art_source/.gitkeep -filter -diff -merge text
# UI icon sources are small hand-written SVG text (blueprint UI02): keep them diffable and readable without LFS.
art_source/ui_icons/*.svg -filter -diff -merge text eol=lf
