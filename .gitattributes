# Cloud sessions (Linux) and your PC (Windows) both write to this repo: keep LF everywhere.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Godot / data files are text
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# binaries
*.png binary
*.jpg binary
*.pdf binary
*.ogg binary
*.wav binary
*.glb binary
*.exe binary

# Large originals live in art_source/ (outside the exported asset tree) and go through Git LFS.
# Requires `git lfs install` once per machine. Cloud sessions do not need these files.
art_source/** filter=lfs diff=lfs merge=lfs -text
