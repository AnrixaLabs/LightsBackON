{
  "_note": "Design tokens from blueprint section 9 (p.11) and ADR-004. Pixel sizes are on the 1920x1080 design canvas, scaled by the UI scale slider. Fonts are not chosen here: Noto Sans (or another licensed font) needs owner approval before it is added.",
  "colors": {
    "background": "#111B25",
    "panel": "#1B2A38",
    "elevated": "#243748",
    "text": "#F3F5EF",
    "text_muted": "#B9C6CF",
    "restored": "#65D6B4",
    "action": "#FFC86B",
    "fault": "#F28B82",
    "unknown": "#7E93A3"
  },
  "overlay": {"panel_alpha_percent": 100, "worst_backdrop": "#FFFFFF", "best_backdrop": "#000000"},
  "type_px": {"body": 22, "button": 26, "heading_min": 32, "heading_max": 44},
  "large_text_px": 24,
  "min_target_px": 48,
  "safe_area_px": 80,
  "ui_scale_percent": {"min": 80, "max": 150, "default": 100},
  "max_objective_rows": 3,
  "contrast_rules": [
    {"fg": "text", "on": ["background", "panel", "elevated"], "use": "body"},
    {"fg": "text_muted", "on": ["background", "panel", "elevated"], "use": "body"},
    {"fg": "restored", "on": ["background", "panel", "elevated"], "use": "body"},
    {"fg": "action", "on": ["background", "panel", "elevated"], "use": "body"},
    {"fg": "fault", "on": ["background", "panel", "elevated"], "use": "body"},
    {"fg": "unknown", "on": ["background", "panel"], "use": "body"},
    {"fg": "unknown", "on": ["elevated"], "use": "icon_or_large"},
    {"fg": "background", "on": ["action", "restored"], "use": "body"}
  ]
}
