       {"op": "set", "id": "NOWHERE", "field": "enabled", "value": true, "expect": "UNKNOWN_ID", "expect_ids": []},
       {"op": "set", "id": "GRID", "field": "capacity", "value": true, "expect": "FIELD_NOT_SETTABLE", "expect_ids": ["GRID"]},
       {"op": "set", "id": "PUB", "field": "enabled", "value": 1, "expect": "BAD_VALUE", "expect_ids": ["PUB"]},
